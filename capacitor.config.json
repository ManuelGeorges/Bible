{
  "appId": "com.agios.bible",
  "appName": "Agios Bible",
  "webDir": "out",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": [
      "localhost"
    ]
  },
  "plugins": {
    "StatusBar": {
      "overlay": false,
      "backgroundColor": "#ffffff",
      "style": "LIGHT"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": [
        "google.com",
        "apple.com"
      ],
      "googleClientId": "900022943169-p5r8tqgfb603vqtfdthh1hv7vr94eqrr.apps.googleusercontent.com"
    },
    "SplashScreen": {
      "launchShowDuration": 1000,
      "launchAutoHide": false,
      "backgroundColor": "#f0f4f8",
      "androidScaleType": "CENTER",
      "showSpinner": false
    },
    "AppUpdate": {
      "appleAppId": "6470000000"
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK",
      "setAccessoryBarVisible": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  },
  "android": {
    "backgroundColor": "#f0f4f8",
    "allowMixedContent": true
  }
}
