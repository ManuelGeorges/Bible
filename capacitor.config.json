{
  "appId": "com.agios.bible",
  "appName": "Agios Bible",
  "webDir": "out",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "allowNavigation": [
      "localhost"
    ]
  },
  "plugins": {
    "StatusBar": {
      "overlay": false,
      "backgroundColor": "#ffffff",
      "style": "LIGHT"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": [
        "google.com",
        "apple.com"
      ]
    },
    "SplashScreen": {
      "launchShowDuration": 1000,
      "launchAutoHide": false,
      "backgroundColor": "#f0f4f8",
      "androidScaleType": "CENTER",
      "showSpinner": false
    },
    "AppUpdate": {
      "appleAppId": ""
    }
  },
  "android": {
    "backgroundColor": "#f0f4f8",
    "allowMixedContent": true
  }
}