{
  "appId": "com.agios.bible",
  "appName": "Agios Bible",
  "webDir": "out",
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": ["google.com"]
    },
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "backgroundColor": "#191d34",
      "androidScaleType": "CENTER_CROP"
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "stats": true,
      "resetWhenError": true
    }
  }
}