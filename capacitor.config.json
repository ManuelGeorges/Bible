{
  "appId": "com.agios.bible",
  "appName": "Agios Bible",
  "webDir": "out",
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": [
        "google.com"
      ]
    },
"SplashScreen": {
    "launchShowDuration": 1000, 
    "launchAutoHide": false, 
    "backgroundColor": "#0f172a",
    "androidScaleType": "CENTER_CROP",
    "showSpinner": false
  },
    "CapacitorUpdater": {
      "appId": "com.agios.bible",
      "version": "1.0.3",
      "autoUpdate": false,
      "stats": true,
      "resetWhenError": true
    }
  }
}