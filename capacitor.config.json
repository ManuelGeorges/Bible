{
  "appId": "com.agios.bible",
  "appName": "Agios Bible",
  "webDir": "out",
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "StatusBar": {
      "overlay": false,
      "backgroundColor": "#ffffff",
      "style": "LIGHT"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": [
        "google.com",
        "apple.com"
      ]
    },
    "SplashScreen": {
      "launchShowDuration": 1000,
      "launchAutoHide": false,
      "backgroundColor": "#f0f4f8",
      "androidScaleType": "CENTER",
      "showSpinner": false
    },
    "CapacitorUpdater": {
      "appId": "com.agios.bible",
      "version": "1.0.3",
      "autoUpdate": false,
      "stats": true,
      "resetWhenError": true
    }
  },
  "android": {
    "backgroundColor": "#f0f4f8",
    "allowMixedContent": true
  },
  "ios": {
    "contentInset": "always"
  }
}