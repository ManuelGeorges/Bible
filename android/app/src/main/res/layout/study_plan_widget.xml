<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:text="@string/widget_label_study_plan"
        android:textColor="@color/widget_plan_accent"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/widget_divider"
        android:layout_width="32dp"
        android:layout_height="2dp"
        android:layout_below="@id/widget_title"
        android:layout_marginTop="6dp"
        android:background="@color/widget_plan_accent"
        android:contentDescription="divider" />

    <ListView
        android:id="@+id/widget_plans_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_divider"
        android:layout_marginTop="12dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp" />

    <TextView
        android:id="@+id/widget_empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_divider"
        android:gravity="center"
        android:text="@string/widget_no_plan"
        android:textColor="@color/widget_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

</RelativeLayout>