<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:text="@string/widget_label_study_plan"
        android:textColor="#1E3A8A"
        android:textSize="12sp"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        android:textStyle="bold" />

    <View
        android:id="@+id/widget_divider"
        android:layout_width="24dp"
        android:layout_height="2dp"
        android:layout_below="@id/widget_title"
        android:layout_marginTop="4dp"
        android:background="#3B82F6" />

    <ListView
        android:id="@+id/widget_plans_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_divider"
        android:layout_marginTop="8dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="2dp" />

    <TextView
        android:id="@+id/widget_empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_divider"
        android:gravity="center"
        android:text="@string/widget_no_plan"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:visibility="gone" />

</RelativeLayout>